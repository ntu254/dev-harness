{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "paths": {
      "@dev-harness/spec": ["../spec/dist/index.d.ts"],
      "@dev-harness/kernel": ["../kernel/dist/index.d.ts"],
      "@dev-harness/adapters": ["../adapters/dist/index.d.ts"]
    }
  },
  "references": [
    { "path": "../spec" },
    { "path": "../kernel" },
    { "path": "../adapters" }
  ],
  "include": ["src/**/*"]
}
